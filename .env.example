# Source-build configuration for compose.source.yaml.
# Copy this file to .env and keep credentials out of Git.

# Absolute path to the media directory on the Docker host.
MOVA_MEDIA_PATH=/absolute/path/to/media

# Optional TMDB API Read Access Token. Leave empty to disable remote scraping.
MOVA_TMDB_ACCESS_TOKEN=

# Optional proxy URL reachable from Docker, for example http://192.168.1.1:7890.
HTTP_PROXY=
HTTPS_PROXY=
